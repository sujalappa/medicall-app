APP_ENV=dev
API_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/saleslens
REDIS_URL=redis://localhost:6379/0
HF_TOKEN=replace_me
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_MODEL_ANALYSIS=Qwen/Qwen3.5-9B:together
HF_MODEL_QA=Qwen/Qwen3.5-9B:together
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
DIARIZATION_DEVICE=cuda
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda
EMBEDDING_DIM=384
UPLOAD_DIR=./storage/uploads
INDEX_DIR=./storage/indexes
TRANSCRIPT_CHUNK_SIZE=800
USE_LLM_INTELLIGENCE=true
MAX_GPU_MEMORY_MB=0
